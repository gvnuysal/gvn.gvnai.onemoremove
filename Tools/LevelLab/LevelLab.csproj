<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline level design tool. It compiles the game's own pure C# assemblies (Core, Session, Persistence) from
    Assets/_Project/Scripts, so every search runs through the real RulesEngine. Unity never sees this folder.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>OneMoreMove.LevelLab</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS1591;CS0649</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <GameScripts>$(MSBuildThisFileDirectory)../../Assets/_Project/Scripts</GameScripts>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(GameScripts)/Core/**/*.cs" LinkBase="Game/Core" />
    <Compile Include="$(GameScripts)/Session/**/*.cs" LinkBase="Game/Session" />
    <Compile Include="$(GameScripts)/Persistence/**/*.cs" LinkBase="Game/Persistence" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unity's com.unity.nuget.newtonsoft-json 3.2.x ships Newtonsoft.Json 13.0.x. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
