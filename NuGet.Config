<?xml version="1.0" encoding="utf-8"?>
<!-- .NET projects outside Unity (Tools/, Server/) restore from nuget.org only, independent of machine-wide feeds. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
